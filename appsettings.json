    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection":"Server=localhost:5432;User Id=postgres;Password=postgrespw;Database=ATSDb"
  },
    "Endpoint":{
    "BASEUri": "http://localhost:5001/",
     "UserLogin": "/api/account/signin",
